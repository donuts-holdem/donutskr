NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for Vercel Cron → /api/cron/purge-trash (Bearer token).
CRON_SECRET=

# Admin allowlist: comma-separated admin login emails (case-insensitive).
# When set, only these users may perform admin mutations. When unset, any
# authenticated user is allowed (legacy fallback — set this before deploying).
# Keep in sync with the public.admin_emails table (migration 0017).
ADMIN_EMAILS=admin@example.com
