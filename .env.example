NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: username lookup and persistent authentication throttling.
# Never prefix this key with NEXT_PUBLIC_. Rotate previously shared credentials.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin used in authentication emails. Use HTTPS in production.
SITE_URL=http://localhost:3000

# Optional extra restriction for administrators.
# public.admin_emails / is_admin() always determine database privileges.
# Leaving this empty NEVER grants admin access.
ADMIN_EMAILS=
